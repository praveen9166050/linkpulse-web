{
    "name": "linkpulse-web",
    "version": "0.0.0",
    "description": "LinkPulse dashboard: create and browse short links, and watch the API work",
    "private": true,
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "next dev --port 3001",
        "build": "next build",
        "start": "next start --port 3001",
        "api:generate": "openapi-typescript ../linkpulse/api/openapi.yaml -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run format:check && npm run lint && npm run typecheck"
    },
    "dependencies": {
        "class-variance-authority": "0.7.1",
        "cn": "0.5.2",
        "lucide-react": "1.72.0",
        "next": "16.4.6",
        "next-themes": "0.4.6",
        "openapi-fetch": "0.17.0",
        "radix-ui": "1.8.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "shadcn": "4.23.0",
        "sonner": "2.0.8",
        "tw-animate-css": "1.4.0"
    },
    "devDependencies": {
        "@tailwindcss/turbopack": "4.3.3",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "9.39.5",
        "eslint-config-next": "16.4.6",
        "eslint-config-prettier": "10.1.8",
        "openapi-typescript": "7.13.0",
        "prettier": "3.10.1",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "typescript-eslint": "8.72.2"
    }
}
